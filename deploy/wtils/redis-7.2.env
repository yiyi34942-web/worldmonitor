# Future Mac mini / Mac Studio Redis policy.
# Do not apply this file to the Air legacy Redis.
# Floating tags are rejected. The digest stays unbound until hardware acceptance.

WTILS_REDIS_IMAGE_REPOSITORY=redis
WTILS_REDIS_IMAGE_TAG=7.2.12
WTILS_REDIS_IMAGE_DIGEST=sha256:UNBOUND_UNTIL_HARDWARE_ACCEPTANCE
WTILS_REDIS_IMAGE=redis:7.2.12@sha256:UNBOUND_UNTIL_HARDWARE_ACCEPTANCE
WTILS_REDIS_IMAGE_POLICY=EXACT_DIGEST_REQUIRED
WTILS_REDIS_APPLY_ON_AIR=false
