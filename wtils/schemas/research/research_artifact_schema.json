{
  "type": "object",
  "description": "WTILS Research Artifact contract with multi-profile support",
  "properties": {
    "artifact_id": {
      "type": "string",
      "description": "Unique artifact identifier"
    },
    "primary_profile_id": {
      "type": "string",
      "description": "Primary analysis profile"
    },
    "profile_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "uniqueItems": true,
      "description": "All applicable profiles (includes primary)"
    },
    "methodology_id": {
      "type": "string"
    },
    "role_id": {
      "type": "string"
    },
    "pit": {
      "type": "object",
      "description": "PIT observation lineage"
    },
    "version": {
      "type": "string"
    }
  },
  "required": [
    "artifact_id",
    "primary_profile_id",
    "profile_ids"
  ],
  "constraints": [
    "primary_profile_id MUST exist in profile_ids",
    "profile_ids minItems=1, uniqueItems=true",
    "No singular profile_id field in active contract"
  ]
}